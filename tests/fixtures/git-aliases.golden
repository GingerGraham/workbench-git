copilot=gh copilot
gaa=git add --all
gap=git add -p
gba=git branch -a
gbd=git branch -D
gbdl=git branch -d
gbr=git branch
gca=git commit --amend --no-edit
gcb=git checkout -b
gcl=git clone
gcm=git commit -m
gco=git checkout
gd=git diff
gds=git diff --staged
gf=git fetch
gfa=git fetch --all
gfp=git fetch --prune
gitcleanup=git-cleanup
gitgraph=git log --oneline --graph --decorate --all
gitkeep=find . -type d -empty -exec touch {}/.gitkeep \;
glo=git log --oneline --graph --decorate
gpf=git push --force-with-lease
gpl=git pull
gplr=git pull --rebase
gpop=git stash pop
gps=git push
gpsh=git push
grb=git rebase
grbi=git rebase -i
grs=git restore
grst=git restore
gst=git status
gstash=git stash
gstp=git status --porcelain
gsw=git switch
gswc=git switch -c
gswm=git switch main
upgrade-copilot=gh extension upgrade gh-copilot
